    "nameTransform": "none",
    "showRole": true,
    "underlineAfterContact": true
  },
  "contact": {
    "layout": "inline"
  },
  "sectionOrder": ["summary", "education", "experience", "skills"],
  "experience": {
    "layout": "twoColumn",
    "showAddress": false
  },
