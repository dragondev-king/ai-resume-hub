{
  "id": "emerald-serif",
  "name": "Emerald Serif",
  "colors": {
    "primary": "065F46",
    "accent": "059669",
    "body": "374151",
    "muted": "6B7280"
  },
  "fonts": {
    "heading": "Georgia",
    "body": "Garamond"
  },
  "sizes": {
    "name": 25,
    "title": 12,
    "section": 11,
    "experienceHeading": 11,
    "experienceMeta": 9,
    "body": 9,
    "contact": 8
  },
  "spacing": {
    "charSpacingDocx": 6,
    "lineDocx": 288,
